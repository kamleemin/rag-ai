PORT=8080
DATABASE_URL=postgresql://...
# Comma-separated: your Vercel domain + local Next dev.
# "*" matches one branch name (letters/digits/dashes) — never use https://*.vercel.app.
CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-*-your-team.vercel.app,http://localhost:3000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
ASK_MIN_SIMILARITY=0.3
# Free key: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=
